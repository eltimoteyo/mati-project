{
  "name": "conit-support",
  "version": "0.1.0",
  "private": true,
  "description": "CONIT Support - Sistema web corporativo de soporte tecnico",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "db:setup": "node scripts/setup-db-local.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @conit/api db:generate",
    "db:migrate": "pnpm --filter @conit/api db:migrate",
    "db:deploy": "pnpm --filter @conit/api db:deploy",
    "db:seed": "pnpm --filter @conit/api db:seed",
    "db:studio": "pnpm --filter @conit/api db:studio",
    "db:reset": "pnpm --filter @conit/api db:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "@conit/config": "workspace:*",
    "next": "16.3.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.7.4",
    "rimraf": "6.0.1",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  }
}
