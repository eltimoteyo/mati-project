# =============================================================================
# CONIT SUPPORT - Variables de entorno (raiz del monorepo)
# =============================================================================
# Copia este archivo como `.env` y ajusta los valores.
# NUNCA subas el archivo `.env` al repositorio.
#
#   cp .env.example .env
#
# Este archivo es consumido por docker-compose y por los scripts de Prisma.
# Cada app tiene ademas su propio `.env.example` (apps/api y apps/web).
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# PostgreSQL (contenedor `postgres` de docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=conit
POSTGRES_PASSWORD=change_me_in_local
POSTGRES_DB=conit_support
POSTGRES_PORT=5432

# Cadena de conexion usada por Prisma.
# Desde el host (pnpm dev):        localhost
# Desde docker-compose (servicio): postgres
DATABASE_URL=postgresql://conit:change_me_in_local@localhost:5432/conit_support?schema=public

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
API_PORT=4000
PORT=4000
API_PREFIX=api/v1
API_INTERNAL_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Genera valores unicos con:  openssl rand -base64 48
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=reemplaza_por_otro_secreto_largo_y_aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Cookies de sesion
# -----------------------------------------------------------------------------
COOKIE_DOMAIN=
COOKIE_SECURE=false
# lax | strict | none   (none exige COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# El limite de intentos de login (5 por minuto) es una constante de seguridad
# definida en apps/api/src/auth/auth.constants.ts, no una variable de entorno.

# -----------------------------------------------------------------------------
# Seed del administrador inicial
# -----------------------------------------------------------------------------
ADMIN_NAME=Administrador CONIT
ADMIN_EMAIL=admin@conit.com
ADMIN_PASSWORD=

# Cliente de demostracion (rol CLIENT)
CLIENT_NAME=Cliente Demo
CLIENT_EMAIL=cliente@conit.com
CLIENT_PASSWORD=

# Pon "true" para sembrar clientes, servicios y tickets ficticios con los que
# evaluar el panel. Dejalo desactivado en produccion.
SEED_DEMO_DATA=false

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME=CONIT Support
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# IA (OpenRouter) — opcional
# -----------------------------------------------------------------------------
# Sin clave, el asistente se declara no disponible y el resto funciona igual.
# Obten la tuya en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Reserva para modelos gratuitos saturados.
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.2:free,google/gemma-4-31b-it:free,minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# WhatsApp (Twilio) — opcional
# -----------------------------------------------------------------------------
# Sin TWILIO_ACCOUNT_SID ni TWILIO_AUTH_TOKEN el webhook responde 403.
# Obten las credenciales en https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero de WhatsApp de CONIT en formato whatsapp:+... (ej: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=
# URL publica HTTPS del webhook configurada en el sandbox de WhatsApp.
WHATSAPP_WEBHOOK_URL=https://TU-DOMINIO.com/api/v1/whatsapp/webhook
WHATSAPP_ENABLED=true

# -----------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) — opcional
# -----------------------------------------------------------------------------
# Avisa al cliente por WhatsApp cuando su ticket pasa a Resuelto o Cerrado.
# Sin token o sin identificador de numero el aviso se omite.
# Token permanente de un usuario del sistema (configuracion del negocio en Meta).
WHATSAPP_ACCESS_TOKEN=
# Identificador del numero remitente; no es el numero de telefono.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v26.0
# Plantilla aprobada en Meta con tres variables en el cuerpo:
#   {{1}} codigo del ticket   {{2}} asunto   {{3}} estado
WHATSAPP_TEMPLATE_TICKET_STATUS=ticket_actualizacion
WHATSAPP_TEMPLATE_LANGUAGE=es

