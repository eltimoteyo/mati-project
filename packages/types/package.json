{
  "name": "@conit/types",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos y tipos TypeScript compartidos entre la API y el frontend",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@conit/config": "workspace:*",
    "eslint": "9.39.5",
    "rimraf": "6.0.1",
    "typescript": "5.9.3"
  }
}
