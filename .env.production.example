# =============================================================================
# CONIT SUPPORT — Variables de produccion (Vercel + API Cloud/Railway/VPS)
# =============================================================================
# Frontend: Desplegado en Vercel (https://conit-support.vercel.app)
# Backend: Desplegado en Railway / VPS / Cloud
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# Dominio Frontend (Vercel)
# -----------------------------------------------------------------------------
DOMAIN=conit-support.vercel.app

# -----------------------------------------------------------------------------
# PostgreSQL (Neon / Supabase / RDS / VPS)
# -----------------------------------------------------------------------------
# Cadena de conexion directa a PostgreSQL (ej. Neon Tech)
DATABASE_URL=

# -----------------------------------------------------------------------------
# Puertos internos
# -----------------------------------------------------------------------------
PORT=4000
API_PORT=4000
WEB_PORT=3000
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# JWT — OBLIGATORIO, y distintos entre si (minimo 32 caracteres)
# -----------------------------------------------------------------------------
# Genera cada uno con:  openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Cookies
# -----------------------------------------------------------------------------
COOKIE_DOMAIN=
COOKIE_SECURE=true
# lax si se usa el proxy de Vercel (mismo origen) o none para peticiones cross-domain directas
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# URLs publicas y CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=https://conit-support.vercel.app
CORS_ORIGINS=https://conit-support.vercel.app
# En el frontend de Vercel se puede configurar como `/api/v1` (usando rewrites) o la URL directa de la API
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=CONIT Support

# -----------------------------------------------------------------------------
# Limites y documentacion
# -----------------------------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# Apagado en produccion: publicar el esquema completo de la API no aporta nada
# y facilita el trabajo a quien busque agujeros.
SWAGGER_ENABLED=false

# -----------------------------------------------------------------------------
# Usuario administrador inicial — OBLIGATORIO
# -----------------------------------------------------------------------------
# Solo se usan al ejecutar el seed. La contrasena se aplica UNICAMENTE al crear
# el usuario: si ya existe, el seed no la sobrescribe.
# Minimo 8 caracteres. Genera una con:  openssl rand -base64 18
ADMIN_NAME=Administrador CONIT
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Usuario de rol CLIENT. Dejalo vacio: el portal de cliente todavia no existe.
CLIENT_NAME=
CLIENT_EMAIL=
CLIENT_PASSWORD=

# Datos de ejemplo. En produccion debe quedarse en `false`.
SEED_DEMO_DATA=false

# -----------------------------------------------------------------------------
# Asistente de IA (OpenRouter) — opcional
# -----------------------------------------------------------------------------
# Sin clave, el asistente se declara no disponible y el resto funciona igual.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free,openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Correo saliente (Resend) — opcional
# -----------------------------------------------------------------------------
# MAIL_FROM debe pertenecer a un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM=CONIT Support <soporte@novatec.ink>
MAIL_REPLY_TO=
MAIL_LOGO_URL=https://conit.novatec.ink/brand/conit-logo.png
MAIL_ENABLED=true

# -----------------------------------------------------------------------------
# Correo entrante (opcional)
# -----------------------------------------------------------------------------
# Convierte los correos que llegan a la direccion de soporte en tickets. Sin
# este secreto el endpoint rechaza todo: aceptar webhooks sin firmar permitiria
# a cualquiera crear tickets.
#
# Se obtiene al dar de alta el webhook en Resend apuntando a
#   https://conit.novatec.ink/api/v1/mail/inbound
RESEND_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) — opcional
# -----------------------------------------------------------------------------
# Avisa al cliente por WhatsApp cuando su ticket pasa a Resuelto o Cerrado.
# Sin token o sin identificador de numero el aviso se omite.
# Token permanente de un usuario del sistema (configuracion del negocio en Meta).
WHATSAPP_ACCESS_TOKEN=
# Identificador del numero remitente; no es el numero de telefono.
WHATSAPP_PHONE_NUMBER_ID=
# Bandeja: recepcion de mensajes por webhook. Sin estas dos no se recibe nada.
# Clave secreta de la app (configuracion basica en Meta); firma cada webhook.
WHATSAPP_APP_SECRET=
# Cadena que inventamos y repetimos en Meta al registrar el webhook:
#   https://api.conit.novatec.ink/api/v1/whatsapp/meta/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# Plantilla aprobada en Meta con tres variables en el cuerpo:
#   {{1}} codigo del ticket   {{2}} asunto   {{3}} estado
WHATSAPP_TEMPLATE_TICKET_STATUS=ticket_actualizacion
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_ENABLED=true

# -----------------------------------------------------------------------------
# Ficheros subidos
# -----------------------------------------------------------------------------
# Carpeta de las fotos de perfil. En Docker se deja en /app/uploads, que el
# compose monta como volumen: dentro de la imagen se perderian en cada
# despliegue.
UPLOADS_DIR=/app/uploads
