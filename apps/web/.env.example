# =============================================================================
# CONIT SUPPORT — Web (Next.js)
# =============================================================================
# Copia este archivo como `apps/web/.env.local`:
#
#   cp apps/web/.env.example apps/web/.env.local
#
# Las variables `NEXT_PUBLIC_*` se incrustan en el bundle del navegador:
# no coloques aqui ningun secreto.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# URL que usa el NAVEGADOR para hablar con la API (incluye el prefijo).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# URL que usa el SERVIDOR de Next para hablar con la API.
# En local coincide con la anterior; dentro de docker compose es el nombre
# del servicio: http://api:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1

# -----------------------------------------------------------------------------
# Identidad de la aplicacion
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=CONIT Support
