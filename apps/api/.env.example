# =============================================================================
# CONIT SUPPORT — API (NestJS)
# =============================================================================
# Copia este archivo como `apps/api/.env`:
#
#   cp apps/api/.env.example apps/api/.env
#
# El CLI de Prisma lee este archivo, por eso DATABASE_URL debe estar aqui.
# NUNCA subas el archivo `.env` al repositorio.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
PORT=4000
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# Desde el host (pnpm dev):          @localhost:5432
# Desde docker compose (servicio):   @postgres:5432
DATABASE_URL=postgresql://conit:change_me_in_local@localhost:5432/conit_support?schema=public

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Minimo 32 caracteres cada uno. Genera valores unicos con:
#   openssl rand -base64 48
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio_de_48_caracteres
JWT_REFRESH_SECRET=reemplaza_por_otro_secreto_largo_y_aleatorio_distinto

# Vigencia del access token (corta: se renueva con el refresh token)
JWT_ACCESS_EXPIRES_IN=15m
# Vigencia del refresh token sin "Recordarme"
JWT_REFRESH_EXPIRES_IN=7d
# Vigencia del refresh token con "Recordarme"
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Cookies de sesion
# -----------------------------------------------------------------------------
# Vacio en local. En produccion, por ejemplo: .conit.com
COOKIE_DOMAIN=
# true obligatorio en produccion (HTTPS)
COOKIE_SECURE=false
# lax | strict | none   (none exige COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# Lista separada por comas. Si se omite, se usa FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting global
# -----------------------------------------------------------------------------
# Ventana en milisegundos y numero maximo de peticiones por ventana.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
# El limite de intentos de login (5 por minuto) es una constante de seguridad
# en src/auth/auth.constants.ts, no una variable de entorno.

# -----------------------------------------------------------------------------
# Documentacion
# -----------------------------------------------------------------------------
# Desactivala en produccion si la API es publica.
SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# Seed del administrador inicial  (pnpm db:seed)
# -----------------------------------------------------------------------------
ADMIN_NAME=Administrador CONIT
ADMIN_EMAIL=admin@conit.com
# Minimo 8 caracteres. El seed rechaza valores de ejemplo.
ADMIN_PASSWORD=
# Cliente de demostracion (rol CLIENT), util para probar el control de acceso
# al panel administrativo. Puedes omitirlo en produccion.
CLIENT_NAME=Cliente Demo
CLIENT_EMAIL=cliente@conit.com
# Minimo 8 caracteres. El seed rechaza valores de ejemplo.
CLIENT_PASSWORD=

# Pon "true" para sembrar clientes, servicios y tickets ficticios con los que
# evaluar el panel. Dejalo desactivado en produccion.
SEED_DEMO_DATA=false

# -----------------------------------------------------------------------------
# Asistente de IA (OpenRouter) — opcional
# -----------------------------------------------------------------------------
# Sin clave, el asistente se declara no disponible y el resto del sistema
# funciona igual. Obten la tuya en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Con creditos en OpenRouter: anthropic/claude-haiku-4.5 da mejor calidad.
OPENROUTER_FALLBACK_MODELS=z-ai/glm-5.2:free,google/gemma-4-31b-it:free,minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Correo saliente (Resend) — opcional
# -----------------------------------------------------------------------------
# Sin clave no se envia ningun correo; los tickets siguen funcionando.
# MAIL_FROM debe pertenecer a un dominio verificado en Resend. El remitente de
# pruebas onboarding@resend.dev solo entrega al correo del titular de la cuenta.
RESEND_API_KEY=
MAIL_FROM=CONIT Support <soporte@tu-dominio.com>
MAIL_REPLY_TO=
MAIL_LOGO_URL=https://tu-dominio.com/brand/conit-logo.png
MAIL_ENABLED=true
